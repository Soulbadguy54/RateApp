(rateapp_common) {
    encode gzip zstd
    @api path /api/*
    handle @api {
        # Production and staging share a Docker network; both services are named
        # "api" and Docker DNS would otherwise randomly pick the stage API.
        # Compose project "rateapp" names the production container rateapp-api-1.
        reverse_proxy rateapp-api-1:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

r-app.ru, www.r-app.ru {
    import rateapp_common
}

:8080 {
    import rateapp_common
}

dev.r-app.ru {
    encode gzip zstd
    header X-Robots-Tag "noindex, nofollow, noarchive"
    @api path /api/*
    handle @api {
        reverse_proxy rateapp-stage-api:8000
    }
    handle {
        reverse_proxy rateapp-stage-web:8080
    }
}
